config BR2_PACKAGE_PYTHON_PICAMERA2
	bool "python-picamera2"
	depends on BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_LIBCAMERA
	select BR2_PACKAGE_LIBCAMERA_PYTHON
	select BR2_PACKAGE_PYTHON_NUMPY
	select BR2_PACKAGE_PYTHON_PILLOW
	select BR2_PACKAGE_PYTHON_PIEXIF
	select BR2_PACKAGE_PYTHON_PIDNG
	select BR2_PACKAGE_PYTHON_SIMPLEJPEG
	select BR2_PACKAGE_PYTHON_VIDEODEV2
	select BR2_PACKAGE_PYTHON_PRCTL
	select BR2_PACKAGE_PYTHON_LIBARCHIVE_C
	select BR2_PACKAGE_PYTHON_TQDM
	select BR2_PACKAGE_PYTHON_JSONSCHEMA
	help
	  Raspberry Pi camera library for Python. Without PyAV (libav encoders) and OpenEXR (IMX500 only).
