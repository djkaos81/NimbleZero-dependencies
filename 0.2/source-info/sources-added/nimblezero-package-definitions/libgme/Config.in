config BR2_PACKAGE_LIBGME
	bool "libgme (game-music-emu)"
	depends on BR2_INSTALL_LIBSTDCPP
	select BR2_PACKAGE_ZLIB
	help
	  Video game music emulation library: NES, SNES, Genesis/VGM,
	  Game Boy, PC Engine, MSX, ZX Spectrum, Atari.  Used by the
	  Media Player (package nz-lib-libgme).

	  https://github.com/libgme/game-music-emu

comment "libgme needs a toolchain w/ C++"
	depends on !BR2_INSTALL_LIBSTDCPP
